GROK_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SOURCE_DOCUMENT_PATH=./cisco-nexus-9000-series-nx-os-troubleshooting-guide-106x.pdf
CHROMA_PERSIST_DIRECTORY=./data/chroma
COLLECTION_NAME=cisco_nexus_troubleshooting
CHUNK_SIZE=1024
CHUNK_OVERLAP=32
FACTUAL_RETRIEVAL_K=4
BROAD_RETRIEVAL_K=20
FACTUAL_FETCH_K=12
BROAD_FETCH_K=20
QUERY_EXPANSION_COUNT=3
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.88
CACHE_FILE_PATH=./data/cache/semantic_cache.json
ANSWER_CONTEXT_CHUNKS=6
